# ============================================================
#  خيار 1: SQLite (التشغيل المحلي على جهازك)
# ============================================================
# DATABASE_URL="file:./dev.db"

# ============================================================
#  خيار 2: Supabase (موصى به للنشر)
#  من Supabase: Project Settings ← Database ← Connection string
# ============================================================
# الرابط المجمع (Pooler) - للتشغيل:
# DATABASE_URL="postgresql://postgres.XXXX:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# الرابط المباشر - للهجرات:
# DIRECT_URL="postgresql://postgres.XXXX:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ============================================================
#  خيار 3: Vercel Postgres / Neon
# ============================================================
# DATABASE_URL="postgres://..."
# (يُضاف تلقائياً عند إنشاء القاعدة من تبويب Storage)

# ---------- الحساب والأمان (مهم جداً) ----------
# حساب المدير الأول (يُنشأ عند أول تشغيل للبذور أو أول دخول)
ADMIN_EMAIL="admin@salon.com"
ADMIN_PASSWORD="change-me-123"

# سر الجلسة - غيّره لنص طويل وعشوائي
SESSION_SECRET="change-this-to-a-long-random-secret"

# مفتاح حماية رابط التذكيرات /api/cron/reminders?key=
CRON_SECRET="some-random-cron-key"

# ---------- الإشعارات (اختياري) ----------
# waProvider=link|ultramsg|callmebot|twilio|webhook
# smtpHost / smtpPort / smtpUser / smtpPass / smtpFrom
