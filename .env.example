# ============================================================
#  الربط مع Supabase (مطلوب)
#  من لوحة مشروعك في supabase.com:
#  Project Settings ← API
# ============================================================
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi...service_role"

# (اختياري) المفتاح العام — لا يلزم لتشغيل الموقع
# SUPABASE_ANON_KEY="eyJhbGciOi...anon"

# ---------- الحساب والأمان (مهم جداً) ----------
# حساب المدير الأول (يُنشأ تلقائياً عند أول دخول أو عند تشغيل البذور)
ADMIN_EMAIL="admin@salon.com"
ADMIN_PASSWORD="change-me-123"

# سر الجلسة - غيّره لنص طويل وعشوائي
SESSION_SECRET="change-this-to-a-long-random-secret"

# مفتاح حماية رابط التذكيرات /api/cron/reminders?key=
CRON_SECRET="some-random-cron-key"

# ---------- الإشعارات (اختياري) ----------
# تُضبط من لوحة التحكم ← الإعدادات ← الإشعارات:
# waProvider=link|ultramsg|callmebot|twilio|webhook
# smtpHost / smtpPort / smtpUser / smtpPass / smtpFrom
