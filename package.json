{
  "name": "barbershop-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "prisma db push && next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "setup": "prisma db push --skip-generate && node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.2.1",
    "@vercel/blob": "^2.8.0",
    "next": "^15.5.24",
    "nodemailer": "^9.0.6",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "prisma": "6.2.1"
  }
}
