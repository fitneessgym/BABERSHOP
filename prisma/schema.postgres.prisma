// نظام إدارة صالون حلاقة متكامل
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- الإعدادات والتخصيص ----------
model Setting {
  key   String @id
  value String
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("المدير")
  role         String   @default("admin") // owner | admin | staff
  active       Boolean  @default(true)
  lastLogin    DateTime?
  createdAt    DateTime @default(now())
}

// ---------- الخدمات ----------
model Service {
  id          String  @id @default(cuid())
  slug        String  @unique
  nameAr      String
  nameEn      String
  descAr      String  @default("")
  descEn      String  @default("")
  price       Float   @default(0)
  durationMin Int     @default(30)
  icon        String  @default("scissors")
  image       String  @default("")
  category    String  @default("عام")
  active      Boolean @default(true)
  sort        Int     @default(0)
  createdAt   DateTime @default(now())

  barbers     BarberService[]
  bookings    Booking[]
}

// ---------- الحلاقون / الفريق ----------
model Barber {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameAr    String
  nameEn    String
  roleAr    String   @default("حلاق محترف")
  roleEn    String   @default("Professional Barber")
  bioAr     String   @default("")
  bioEn     String   @default("")
  photo     String   @default("")
  rating    Float    @default(5)
  experience Int     @default(5)
  active    Boolean  @default(true)
  sort      Int      @default(0)
  // جدول العمل: JSON { "0": {"open":"10:00","close":"20:00","off":false}, ... }
  schedule  String   @default("")
  createdAt DateTime @default(now())

  services   BarberService[]
  bookings   Booking[]
  timeOff    TimeOff[]
}

model BarberService {
  id        String @id @default(cuid())
  barberId  String
  serviceId String
  barber    Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([barberId, serviceId])
}

// أوقات الإجازة / الحظر
model TimeOff {
  id       String  @id @default(cuid())
  barberId String?
  date     String // YYYY-MM-DD
  time     String  @default("") // فارغ = اليوم كله
  reason   String  @default("")
  barber   Barber? @relation(fields: [barberId], references: [id], onDelete: Cascade)
}

// ---------- الحجوزات ----------
model Booking {
  id           String   @id @default(cuid())
  code         String   @unique
  customerName String
  phone        String
  email        String   @default("")
  serviceId    String
  barberId     String?
  barberName   String   @default("")
  serviceName  String   @default("")
  date         String // YYYY-MM-DD
  time         String // HH:MM
  endTime      String   @default("")
  durationMin  Int      @default(30)
  price        Float    @default(0)
  status       String   @default("pending") // pending | confirmed | completed | cancelled
  notes        String   @default("")
  source       String   @default("website")
  createdAt    DateTime @default(now())

  service Service  @relation(fields: [serviceId], references: [id])
  barber  Barber?  @relation(fields: [barberId], references: [id])
}

// ---------- المتجر ----------
model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  nameAr         String
  nameEn         String
  descAr         String   @default("")
  descEn         String   @default("")
  price          Float    @default(0)
  compareAtPrice Float    @default(0)
  image          String   @default("")
  categoryAr     String   @default("عام")
  categoryEn     String   @default("General")
  brand          String   @default("")
  size           String   @default("")
  stock          Int      @default(0)
  featured       Boolean  @default(false)
  active         Boolean  @default(true)
  sort           Int      @default(0)
  createdAt      DateTime @default(now())

  items OrderItem[]
}

model Order {
  id           String   @id @default(cuid())
  code         String   @unique
  customerName String
  phone        String
  email        String   @default("")
  address      String   @default("")
  city         String   @default("")
  notes        String   @default("")
  subtotal     Float    @default(0)
  shipping     Float    @default(0)
  discount     Float    @default(0)
  total        Float    @default(0)
  coupon       String   @default("")
  payment      String   @default("cash") // cash | card | online
  status       String   @default("new") // new | processing | shipped | delivered | cancelled
  createdAt    DateTime @default(now())

  items OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  nameAr    String
  nameEn    String
  price     Float
  qty       Int     @default(1)
  image     String  @default("")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
}

model Coupon {
  id        String   @id @default(cuid())
  code      String   @unique
  type      String   @default("percent") // percent | fixed
  value     Float    @default(0)
  minTotal  Float    @default(0)
  active    Boolean  @default(true)
  uses      Int      @default(0)
  createdAt DateTime @default(now())
}

// ---------- المحتوى ----------
model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  captionAr String   @default("")
  captionEn String   @default("")
  sort      Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  name      String
  rating    Int      @default(5)
  commentAr String   @default("")
  commentEn String   @default("")
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  name      String
  phone     String   @default("")
  email     String   @default("")
  message   String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Notification {
  id          String   @id @default(cuid())
  type        String   @default("custom")
  channel     String   @default("whatsapp")
  to          String   @default("")
  title       String   @default("")
  body        String   @default("")
  status      String   @default("pending")
  error       String   @default("")
  refId       String   @default("")
  scheduledAt DateTime?
  sentAt      DateTime?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}
